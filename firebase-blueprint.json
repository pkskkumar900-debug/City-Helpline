{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "contributor", "admin"] },
        "createdAt": { "type": "number" },
        "lastLogin": { "type": "number" },
        "banned": { "type": "boolean" },
        "phone": { "type": "string" },
        "businessName": { "type": "string" },
        "businessType": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "photoURL": { "type": "string" },
        "themePreference": { "type": "string", "enum": ["light", "dark", "system"] },
        "savedListings": { "type": "array", "items": { "type": "string" } },
        "notifications": { "type": "boolean" }
      },
      "required": ["uid", "name", "email", "role", "createdAt"]
    },
    "Listing": {
      "title": "Listing",
      "description": "A listing for PG, Hostel, etc.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "price": { "type": "number" },
        "contact": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "featured": { "type": "boolean" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "number" },
        "averageRating": { "type": "number" },
        "reviewCount": { "type": "number" }
      },
      "required": ["title", "description", "category", "city", "address", "price", "contact", "images", "status", "featured", "authorId", "authorName", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "A review for a listing",
      "type": "object",
      "properties": {
        "listingId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["listingId", "userId", "userName", "rating", "comment", "createdAt"]
    },
    "MarketplaceItem": {
      "title": "MarketplaceItem",
      "description": "Student secondhand marketplace items (books, coolers, cycles, furniture)",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "condition": { "type": "string" },
        "city": { "type": "string" },
        "area": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "sellerPhone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "sold"] },
        "createdAt": { "type": "number" },
        "featured": { "type": "boolean" }
      },
      "required": ["title", "description", "price", "category", "condition", "city", "images", "sellerId", "sellerName", "sellerPhone", "status", "createdAt"]
    },
    "RoommateProfile": {
      "title": "RoommateProfile",
      "description": "Student roommate and flatmate profiles for room sharing",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "city": { "type": "string" },
        "locality": { "type": "string" },
        "budgetMin": { "type": "number" },
        "budgetMax": { "type": "number" },
        "roomType": { "type": "string" },
        "targetExam": { "type": "string" },
        "habits": { "type": "object" },
        "bio": { "type": "string" },
        "moveInDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "found"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "photoURL": { "type": "string" }
      },
      "required": ["userId", "userName", "userPhone", "city", "locality", "budgetMin", "budgetMax", "roomType", "targetExam", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles"
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Listings"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reviews"
    },
    "/marketplace_items/{itemId}": {
      "schema": { "$ref": "#/entities/MarketplaceItem" },
      "description": "Student marketplace items"
    },
    "/roommate_profiles/{profileId}": {
      "schema": { "$ref": "#/entities/RoommateProfile" },
      "description": "Student flatmate / roommate profiles"
    }
  }
}
